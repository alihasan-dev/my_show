{   
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Flutter (Android/iOS)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart"
        },
        {
            "name": "Flutter (Web)",
            "request": "launch",
            "type": "dart",
            "args": [
                "-d", "chrome",
                "--web-port", "8000",
                "--dart-define-from-file=.env"
            ],
        },
    ]
}